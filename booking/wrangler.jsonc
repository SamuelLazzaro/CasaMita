/**
 * Cloudflare Workers configuration of the booking module: the deployment
 * serving every venue (today the two of Casa Mita). The code is a copy of
 * the neutral template in the Claude repository, modules/booking.
 *
 * One deployment serves MANY venues. The DIRECTORY database holds the
 * venues (tenants), their configuration and the dashboard users; every
 * venue has its own booking database, listed below with its own binding
 * (the name written in the tenants.binding column of the directory).
 *
 * Adding a venue: `npm run tenant:add -- <slug> ... --remote` creates the
 * database, appends its entry here, applies the migrations and writes the
 * directory rows; then `npm run deploy`.
 *
 * Required secrets (never in this file, never in git):
 *   wrangler secret put ADMIN_SECRET    # HMAC key signing the session cookies
 *   wrangler secret put BREVO_API_KEY   # email notifications (missing = disabled)
 * For local development copy .dev.vars.example to .dev.vars.
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "booking",
    "main": "src/index.ts",
    // Aligned with the workerd version bundled in wrangler ~4.35 (also used by
    // the test pool): do not raise it without upgrading wrangler.
    "compatibility_date": "2025-09-01",
    // Static assets are served BEFORE the Worker runs (zero CPU): their
    // security headers live in public/_headers.
    "assets": {
        "directory": "./public",
        "binding": "ASSETS"
    },
    // Data retention (GDPR art. 5.1.e): once a day, venue by venue, the
    // guests' personal data of bookings ended more than retention_days ago
    // are anonymised.
    "triggers": {
        "crons": ["30 3 * * *"]
    },
    // Workers Logs: console output and per-invocation metadata (including the
    // CPU time of each request) in the dashboard, Observability tab. Off by
    // default: turn it on to measure the CPU time (docs/piano-paid.md). The
    // code logs only errors, never guests' personal data.
    "observability": {
        "enabled": false
    },
    "vars": {
        // PBKDF2 iterations of NEW password hashes (src/password.ts). Workers
        // Free allows 10 ms of CPU per request: on Cloudflare 20000 iterations
        // cost 7-8 ms and the whole login 9-10 ms (measured with Workers Logs),
        // right at the limit; 10000 brings the login to 6 ms (9 ms on a cold
        // isolate). On the Paid plan set
        // 600000 (OWASP); existing hashes are refreshed at the next login of
        // each user.
        "PASSWORD_HASH_ITERATIONS": "10000",
        // "off" skips the Have I Been Pwned check of new passwords.
        "PASSWORD_BREACH_CHECK": "on",
        // Who runs the deployment: shown on the root legal page (/legal,
        // d.lgs. 70/2003 art. 7), named as data processor in the venues'
        // privacy notices, and the contact of /.well-known/security.txt.
        // Public information, not secrets. Empty = placeholders stay.
        "PROCESSOR_NAME": "",
        "PROCESSOR_ADDRESS": "",
        "PROCESSOR_EMAIL": "",
        "PROCESSOR_VAT": ""
    },
    "d1_databases": [
        {
            // The directory: tenants, configuration, users (migrations-directory/).
            "binding": "DIRECTORY",
            "database_name": "booking-directory",
            "database_id": "2573a714-0a9c-4a9c-a3a8-410426bc7577",
            "migrations_dir": "./migrations-directory"
        },
        {
            // Casa Mita B&B (hotel)
            "binding": "DB_CASAMITA",
            "database_name": "booking-casamita",
            "database_id": "fdfca630-d7df-4ba1-8378-a293319d5cee",
            "migrations_dir": "./migrations"
        },
        {
            // Casa Mita Ristorante (restaurant)
            "binding": "DB_CASAMITA_RISTORANTE",
            "database_name": "booking-casamita-ristorante",
            "database_id": "4acea2a6-bfdf-4e73-bd2c-c56c6a45df42",
            "migrations_dir": "./migrations"
        }
    ]
}
